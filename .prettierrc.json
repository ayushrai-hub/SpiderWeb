{
  "semi": true,
  "singleQuote": true,
  "printWidth": 110,
  "trailingComma": "es5",
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "options": { "singleQuote": false }
    },
    {
      "files": ["*.md", "*.yml", "*.yaml"],
      "options": { "printWidth": 90, "proseWrap": "preserve" }
    }
  ]
}
