# SpiderWeb — environment template.
# Copy to .env and adjust. Never commit .env.
#
# The API validates this file at boot and refuses to start with a message
# naming every missing or invalid variable.

# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string. The pg_trgm extension is enabled by migration.
DATABASE_URL=postgresql://dev:dev@127.0.0.1:5433/intel_dev

# ─── Ingestion ───────────────────────────────────────────────────────────────

# inline — the API processes uploads itself, in the background (default).
#          One command runs the whole product; no worker needed.
# queue  — uploads are pushed to a BullMQ queue for the ingestion worker.
#          Requires REDIS_URL and `pnpm dev:worker` (or the worker container).
INGESTION_MODE=inline

# Where uploads are streamed to, and where archives are extracted.
# Both are cleaned up after each import unless KEEP_RAW_UPLOADS=true.
UPLOAD_DIR=/tmp/spiderweb-uploads
TEMP_DIR=/tmp/spiderweb-extract

# Keep raw uploaded archives after processing. Debugging only — the point of
# deleting them is that the parsed data already lives in the database.
KEEP_RAW_UPLOADS=false

# ─── Optional ────────────────────────────────────────────────────────────────

# Redis. Required only for INGESTION_MODE=queue. When set, rate limiting is
# shared across API instances; without it, limits are enforced per process.
REDIS_URL=redis://127.0.0.1:6380

# ─── API server ──────────────────────────────────────────────────────────────

PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# ─── Web app ─────────────────────────────────────────────────────────────────
# Next.js only reads env files inside apps/web. Copy apps/web/.env.example to
# apps/web/.env.local as well.
NEXT_PUBLIC_API_URL=http://localhost:3001
