# SpiderWeb (Professional Intelligence Platform) — environment template
# Copy to .env and fill in real values. NEVER commit .env or real credentials.

# === Database (required) ===
DATABASE_URL=postgresql://dev:dev@127.0.0.1:5433/intel_dev

# === Redis (required — BullMQ job queue) ===
REDIS_URL=redis://127.0.0.1:6380
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# === Supabase Auth (required) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Credential encryption (required) ===
CREDENTIAL_ENCRYPTION_KEY=your-64-char-hex-key

# === Ingestion ===
# Local temp dir for uploaded archives (worker extracts here, then deletes)
UPLOAD_DIR=/tmp/intel-uploads
# Temp dir for ZIP extraction (worker, cleaned after processing)
TEMP_DIR=/tmp/intel-extraction
# Set to "true" ONLY for debugging — keeps raw uploads after parsing.
# Default behavior: raw files deleted after processing (privacy).
KEEP_RAW_UPLOADS=false

# === S3/MinIO object storage (optional — direct-to-storage uploads) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=intel-uploads
S3_REGION=us-east-1

# === API ===
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:3000

# === Web (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:3001

# === AI providers (optional — user-supplied keys stored encrypted) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
